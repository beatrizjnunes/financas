# Local: deixa DATABASE_URL vazio para usar data/financas.db
# Produção (Turso): libsql://<nome>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Passwords dos dois utilizadores (usadas pelo `npm run db:seed`)
IVO_PASSWORD=
BEA_PASSWORD=

# Nomes com que os bancos vos identificam, separados por ";"
# (servem para detetar transferências entre contas próprias e entre vocês)
IVO_BANK_NAMES=
BEA_BANK_NAMES=
